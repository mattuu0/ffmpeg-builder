+/*
+ * output_idx is just the enumeration order DXGI happens to return outputs
+ * in, which is not a stable monitor identity: it can shift whenever a
+ * monitor is unplugged/replugged, a display is disabled/re-enabled, or
+ * Windows re-detects the display topology (e.g. waking from sleep). For a
+ * user-facing "which monitor do I record" setting, output_name (matched
+ * against DXGI_OUTPUT_DESC.DeviceName, e.g. "\\.\DISPLAY1") is far more
+ * stable across those events, though it can still change if the physical
+ * output port a monitor is plugged into changes.
+ *
+ * Only searches outputs on the given (already-selected) adapter, matching
+ * the existing output_idx behavior -- ddagrab captures via one specific
+ * D3D11 device/adapter, so a monitor attached to a different adapter was
+ * never reachable via output_idx either and isn't a new limitation here.
+ */
+static int find_output_by_name(AVFilterContext *avctx, IDXGIAdapter *dxgi_adapter,
+                                const char *output_name, IDXGIOutput **out_output)
+{
+    HRESULT hr;
+    UINT idx;
+    WCHAR wanted[32];
+
+    /* DXGI_OUTPUT_DESC.DeviceName is a fixed WCHAR[32] buffer (e.g.
+     * L"\\.\DISPLAY1"); MultiByteToWideChar converts the UTF-8 AVOption
+     * string to match it for comparison. */
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, output_name, -1, wanted, FF_ARRAY_ELEMS(wanted))) {
+        av_log(avctx, AV_LOG_ERROR, "find_output_by_name: output_name \"%s\" is not valid UTF-8 or too long\n", output_name);
+        return AVERROR(EINVAL);
+    }
+
+    for (idx = 0; ; idx++) {
+        IDXGIOutput *candidate = NULL;
+        DXGI_OUTPUT_DESC desc;
+
+        hr = IDXGIAdapter_EnumOutputs(dxgi_adapter, idx, &candidate);
+        if (hr == DXGI_ERROR_NOT_FOUND)
+            break;
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "find_output_by_name: EnumOutputs failed at index %u: %lx\n", idx, hr);
+            return AVERROR_EXTERNAL;
+        }
+
+        hr = IDXGIOutput_GetDesc(candidate, &desc);
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "find_output_by_name: GetDesc failed at index %u: %lx\n", idx, hr);
+            release_resource(&candidate);
+            return AVERROR_EXTERNAL;
+        }
+
+        if (!wcscmp(desc.DeviceName, wanted)) {
+            *out_output = candidate;
+            return 0;
+        }
+
+        release_resource(&candidate);
+    }
+
+    av_log(avctx, AV_LOG_ERROR, "find_output_by_name: no output named \"%s\" found on this adapter\n", output_name);
+    return AVERROR(ENODEV);
+}
