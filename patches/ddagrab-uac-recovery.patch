+/*
+ * Recreate dda->dxgi_outdupl after the duplication has been invalidated by a
+ * transition away from the input desktop (e.g. a UAC consent prompt
+ * switching to the secure desktop / Winlogon), which surfaces as
+ * DXGI_ERROR_ACCESS_LOST / E_ACCESSDENIED / DXGI_ERROR_INVALID_CALL from
+ * AcquireNextFrame or ReleaseFrame.
+ *
+ * Reuses dda->device_hwctx->device rather than creating a new ID3D11Device:
+ * later CopySubresourceRegion/CopyResource calls use this filter's own
+ * device_context, so a duplication built against a different device would
+ * silently fail to copy. The IDXGIAdapter and IDXGIOutput are always
+ * re-fetched fresh (never cached) because virtual-display adapters (e.g.
+ * remote-desktop drivers) can get a new PnP instance across a desktop
+ * switch; a stale IDXGIAdapter can still report success from
+ * DuplicateOutput(1) while being non-functional. The old duplication object
+ * is released before the new one is created (drop-then-recreate ordering)
+ * since only one live IDXGIOutputDuplication may exist per output at a
+ * time.
+ */
+/*
+ * Attaches the CALLING thread to the current input desktop (which may
+ * already be the UAC secure desktop, or may have just switched back to the
+ * normal desktop). SetThreadDesktop only affects the thread that calls it,
+ * so this must run on whatever thread is about to touch the DXGI calls
+ * below -- ddagrab's frame-pump thread in this case.
+ *
+ * The desktop access mask is the OR of all DESKTOP_* rights (0x1FF), not
+ * GENERIC_ALL: GENERIC_ALL only has meaning through a security descriptor's
+ * generic-rights mapping, which OpenInputDesktop does not apply to the
+ * dwDesiredAccess it's given directly -- passing it here does not actually
+ * grant the specific desktop rights needed and was observed to make the
+ * following DuplicateOutput(1) fail with E_ACCESSDENIED. DF_ALLOWOTHERACCOUNTHOOK
+ * is required because the desktop may currently be owned by a different
+ * security context (Winlogon's secure desktop runs as SYSTEM) than the
+ * thread reattaching to it.
+ */
+static void attach_input_desktop(AVFilterContext *avctx)
+{
+    const DWORD desktop_access = DESKTOP_READOBJECTS | DESKTOP_CREATEWINDOW |
+        DESKTOP_CREATEMENU | DESKTOP_HOOKCONTROL | DESKTOP_JOURNALRECORD |
+        DESKTOP_JOURNALPLAYBACK | DESKTOP_ENUMERATE | DESKTOP_WRITEOBJECTS |
+        DESKTOP_SWITCHDESKTOP;
+    HDESK input_desktop = OpenInputDesktop(DF_ALLOWOTHERACCOUNTHOOK, FALSE, desktop_access);
+
+    if (!input_desktop) {
+        av_log(avctx, AV_LOG_WARNING, "attach_input_desktop: OpenInputDesktop failed: %lu\n", GetLastError());
+        return;
+    }
+
+    if (!SetThreadDesktop(input_desktop))
+        av_log(avctx, AV_LOG_WARNING, "attach_input_desktop: SetThreadDesktop failed: %lu\n", GetLastError());
+
+    CloseDesktop(input_desktop);
+}
+
+/*
+ * Gets the parent IDXGIAdapter for dxgi_device, first checking whether the
+ * DXGI adapter/output topology has become stale (IDXGIFactory1::IsCurrent()
+ * returning FALSE) and, if so, re-fetching the SAME physical adapter (by
+ * AdapterLuid, which identifies a specific GPU and is stable across
+ * topology changes) from a freshly created IDXGIFactory1 instead.
+ *
+ * This is necessary because a virtual display adapter (e.g. a remote-desktop
+ * driver) can tear down and recreate its display device (new PnP instance)
+ * across a rapid secure-desktop<->normal-desktop switch. Simply re-enumerating
+ * outputs on the SAME (possibly now-stale) IDXGIAdapter can still return a
+ * "successful" DuplicateOutput1 against a duplication session that isn't
+ * actually backed by a live display -- i.e. the staleness lives one level up,
+ * on the adapter/factory itself, not just the specific IDXGIOutput object.
+ * IsCurrent() is DXGI's own purpose-built signal for exactly this situation.
+ */
+static int get_current_adapter(AVFilterContext *avctx, IDXGIDevice *dxgi_device, IDXGIAdapter **out_adapter)
+{
+    IDXGIAdapter *adapter = NULL;
+    IDXGIFactory1 *factory = NULL;
+    DXGI_ADAPTER_DESC desc;
+    LUID target_luid;
+    HRESULT hr;
+
+    hr = IDXGIDevice_GetParent(dxgi_device, &IID_IDXGIAdapter, (void**)&adapter);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "get_current_adapter: Failed getting parent IDXGIAdapter: %lx\n", hr);
+        return AVERROR_EXTERNAL;
+    }
+
+    hr = IDXGIAdapter_GetParent(adapter, &IID_IDXGIFactory1, (void**)&factory);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "get_current_adapter: Failed getting parent IDXGIFactory1: %lx\n", hr);
+        release_resource(&adapter);
+        return AVERROR_EXTERNAL;
+    }
+
+    if (IDXGIFactory1_IsCurrent(factory)) {
+        release_resource(&factory);
+        *out_adapter = adapter;
+        return 0;
+    }
+
+    av_log(avctx, AV_LOG_VERBOSE, "get_current_adapter: DXGI topology is stale (IsCurrent()==FALSE); re-creating factory/adapter\n");
+
+    hr = IDXGIAdapter_GetDesc(adapter, &desc);
+    release_resource(&adapter);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "get_current_adapter: Failed getting adapter desc: %lx\n", hr);
+        release_resource(&factory);
+        return AVERROR_EXTERNAL;
+    }
+    target_luid = desc.AdapterLuid;
+    release_resource(&factory);
+
+    hr = CreateDXGIFactory1(&IID_IDXGIFactory1, (void**)&factory);
+    if (FAILED(hr)) {
+        av_log(avctx, AV_LOG_ERROR, "get_current_adapter: CreateDXGIFactory1 failed: %lx\n", hr);
+        return AVERROR_EXTERNAL;
+    }
+
+    for (UINT index = 0; ; index++) {
+        IDXGIAdapter *candidate = NULL;
+        DXGI_ADAPTER_DESC candidate_desc;
+
+        hr = IDXGIFactory1_EnumAdapters(factory, index, &candidate);
+        if (FAILED(hr)) {
+            av_log(avctx, AV_LOG_ERROR, "get_current_adapter: EnumAdapters exhausted without finding matching LUID: %lx\n", hr);
+            release_resource(&factory);
+            return AVERROR_EXTERNAL;
+        }
+
+        hr = IDXGIAdapter_GetDesc(candidate, &candidate_desc);
+        if (FAILED(hr)) {
+            release_resource(&candidate);
+            continue;
+        }
+
+        if (candidate_desc.AdapterLuid.LowPart == target_luid.LowPart &&
+            candidate_desc.AdapterLuid.HighPart == target_luid.HighPart) {
+            av_log(avctx, AV_LOG_VERBOSE, "get_current_adapter: re-acquired the same physical adapter (luid match) from a fresh factory\n");
+            release_resource(&factory);
+            *out_adapter = candidate;
+            return 0;
+        }
+
+        release_resource(&candidate);
+    }
+}
