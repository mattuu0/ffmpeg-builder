+        dda->recovery_attempts < DDAGRAB_MAX_RECOVERY_ATTEMPTS) {
+        av_log(avctx, AV_LOG_WARNING,
+               "ReleaseFrame lost desktop duplication (%lx), attempting recovery (%d/%d)\n",
