+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef FFTOOLS_FFMPEG_IDR_CONTROL_H
+#define FFTOOLS_FFMPEG_IDR_CONTROL_H
+
+/*
+ * Starts the listener thread if idr_control_socket_path (declared in
+ * ffmpeg.h) is non-NULL. Returns 0 on success, including the no-op case
+ * where no path was configured. Returns a negative AVERROR on failure to
+ * start the listener (does not abort the process -- callers should log and
+ * continue without the feature rather than fail the whole run).
+ */
+int idr_control_start(void);
+
+/*
+ * Signals the listener thread to stop and joins it. Safe to call even if
+ * idr_control_start() was a no-op or was never called. Idempotent.
+ */
+void idr_control_stop(void);
+
+/*
+ * Checks whether output stream `ost_index` (the OutputStream::index of the
+ * stream asking) has a pending forced-IDR request it has not yet consumed,
+ * and if so marks it as consumed for that stream and returns 1. Returns 0
+ * otherwise. Thread-safe; safe to call every frame.
+ *
+ * A request targeting a specific stream index only ever satisfies that one
+ * stream. A request with no target (broadcast) satisfies every stream that
+ * has not yet consumed it, once each.
+ */
+int idr_control_consume_request(int ost_index, int64_t *last_seen_epoch);
+
+#endif /* FFTOOLS_FFMPEG_IDR_CONTROL_H */
