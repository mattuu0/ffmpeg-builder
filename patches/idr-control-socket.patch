diff --git a/fftools/ffmpeg_idr_control.c b/fftools/ffmpeg_idr_control.c
new file mode 100644
index 0000000000..ec39d6b631
--- /dev/null
+++ b/fftools/ffmpeg_idr_control.c
@@ -0,0 +1,340 @@
+/*
+ * External IDR/keyframe force control interface.
+ *
+ * This is FFmpeg but you can freely redistribute it and/or modify
+ * it under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/*
+ * Wire protocol (both transports): a client connects, writes one line of
+ * ASCII text terminated by '\n', and the connection is then closed (by
+ * either side) before the next request. Two forms are accepted:
+ *
+ *   force_idr\n           -- force an IDR on every output stream that
+ *                            hasn't already consumed this request
+ *   force_idr <n>\n        -- force an IDR only on output stream index n
+ *
+ * Requests are tracked with a monotonically increasing "epoch" counter
+ * rather than a single one-shot flag, so that multiple output streams in
+ * the same process (e.g. a high-bitrate recording output and a low-bitrate
+ * streaming output from one `ffmpeg` invocation) can each independently
+ * notice and act on the same request exactly once, regardless of which
+ * stream's encode loop happens to poll first.
+ */
+
+#include <stdatomic.h>
+#include <string.h>
+
+#include "ffmpeg_idr_control.h"
+#include "ffmpeg.h"
+
+#include "libavutil/avassert.h"
+#include "libavutil/error.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/thread.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <errno.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#endif
+
+/* 0 means "no request pending yet". First real request is epoch 1. */
+static atomic_int_least64_t g_request_epoch  = 0;
+/* -1 means "broadcast to all streams", otherwise a specific OutputStream::index. */
+static atomic_int           g_request_target = -1;
+
+static pthread_t g_listener_thread;
+static int       g_thread_started = 0;
+
+#ifdef _WIN32
+static HANDLE g_pipe          = INVALID_HANDLE_VALUE;
+static HANDLE g_stop_event    = NULL;
+#else
+static int g_listen_fd        = -1;
+static int g_wakeup_pipe[2]   = { -1, -1 };
+#endif
+
+static void handle_line(const char *line)
+{
+    long target = -1;
+    const char *p = line;
+
+    if (strncmp(p, "force_idr", 9) != 0)
+        return;
+    p += 9;
+
+    while (*p == ' ' || *p == '\t')
+        p++;
+    if (*p >= '0' && *p <= '9')
+        target = strtol(p, NULL, 10);
+
+    atomic_store(&g_request_target, (int)target);
+    /* Store the target before bumping the epoch: a reader that observes the
+     * new epoch is guaranteed to see the matching target, not a stale one
+     * from a previous request (release/consume ordering via the atomic
+     * epoch increment below acts as the publication point). */
+    atomic_fetch_add(&g_request_epoch, 1);
+}
+
+#ifdef _WIN32
+
+static void *listener_main(void *arg)
+{
+    const char *path = idr_control_socket_path;
+    char buf[256];
+
+    for (;;) {
+        HANDLE pipe = CreateNamedPipeA(
+            path,
+            PIPE_ACCESS_INBOUND | FILE_FLAG_OVERLAPPED,
+            PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT,
+            PIPE_UNLIMITED_INSTANCES,
+            0, sizeof(buf), 0, NULL);
+        OVERLAPPED ov = { 0 };
+        HANDLE waitObjs[2];
+        DWORD wait;
+        BOOL connected;
+
+        if (pipe == INVALID_HANDLE_VALUE)
+            break;
+        g_pipe = pipe;
+
+        ov.hEvent = CreateEventA(NULL, TRUE, FALSE, NULL);
+        connected = ConnectNamedPipe(pipe, &ov);
+        if (!connected && GetLastError() == ERROR_IO_PENDING) {
+            waitObjs[0] = ov.hEvent;
+            waitObjs[1] = g_stop_event;
+            wait = WaitForMultipleObjects(2, waitObjs, FALSE, INFINITE);
+            if (wait != WAIT_OBJECT_0) {
+                CloseHandle(ov.hEvent);
+                CloseHandle(pipe);
+                break; /* stop requested */
+            }
+        } else if (!connected && GetLastError() != ERROR_PIPE_CONNECTED) {
+            CloseHandle(ov.hEvent);
+            CloseHandle(pipe);
+            continue;
+        }
+        CloseHandle(ov.hEvent);
+
+        {
+            DWORD n = 0;
+            if (ReadFile(pipe, buf, sizeof(buf) - 1, &n, NULL) && n > 0) {
+                buf[n] = '\0';
+                handle_line(buf);
+            }
+        }
+
+        DisconnectNamedPipe(pipe);
+        CloseHandle(pipe);
+        g_pipe = INVALID_HANDLE_VALUE;
+    }
+
+    return NULL;
+}
+
+int idr_control_start(void)
+{
+    if (!idr_control_socket_path)
+        return 0;
+
+    g_stop_event = CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (!g_stop_event)
+        return AVERROR_EXTERNAL;
+
+    if (pthread_create(&g_listener_thread, NULL, listener_main, NULL) != 0) {
+        CloseHandle(g_stop_event);
+        g_stop_event = NULL;
+        return AVERROR_EXTERNAL;
+    }
+    g_thread_started = 1;
+
+    return 0;
+}
+
+void idr_control_stop(void)
+{
+    if (!g_thread_started)
+        return;
+
+    SetEvent(g_stop_event);
+    /* Unblock a listener that is already parked in a blocking ConnectNamedPipe
+     * (no pending overlapped I/O yet) by connecting to our own pipe once. */
+    if (idr_control_socket_path) {
+        HANDLE h = CreateFileA(idr_control_socket_path, GENERIC_WRITE, 0, NULL,
+                                OPEN_EXISTING, 0, NULL);
+        if (h != INVALID_HANDLE_VALUE)
+            CloseHandle(h);
+    }
+
+    pthread_join(g_listener_thread, NULL);
+    g_thread_started = 0;
+    CloseHandle(g_stop_event);
+    g_stop_event = NULL;
+}
+
+#else /* POSIX */
+
+static void *listener_main(void *arg)
+{
+    char buf[256];
+
+    for (;;) {
+        struct pollfd pfds[2];
+        int nready;
+
+        pfds[0].fd = g_listen_fd;
+        pfds[0].events = POLLIN;
+        pfds[1].fd = g_wakeup_pipe[0];
+        pfds[1].events = POLLIN;
+
+        nready = poll(pfds, 2, -1);
+        if (nready < 0) {
+            if (errno == EINTR)
+                continue;
+            break;
+        }
+
+        if (pfds[1].revents & POLLIN)
+            break; /* stop requested */
+
+        if (pfds[0].revents & POLLIN) {
+            int conn = accept(g_listen_fd, NULL, NULL);
+            if (conn >= 0) {
+                ssize_t n = read(conn, buf, sizeof(buf) - 1);
+                if (n > 0) {
+                    buf[n] = '\0';
+                    handle_line(buf);
+                }
+                close(conn);
+            }
+        }
+    }
+
+    return NULL;
+}
+
+int idr_control_start(void)
+{
+    struct sockaddr_un addr;
+    int fd;
+
+    if (!idr_control_socket_path)
+        return 0;
+
+    if (strlen(idr_control_socket_path) >= sizeof(addr.sun_path))
+        return AVERROR(ENAMETOOLONG);
+
+    fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0)
+        return AVERROR(errno);
+
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    strcpy(addr.sun_path, idr_control_socket_path);
+
+    /* Remove a stale socket file left behind by a prior unclean shutdown
+     * (e.g. kill -9) so bind() below doesn't fail with EADDRINUSE. */
+    unlink(idr_control_socket_path);
+
+    if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+        int err = errno;
+        close(fd);
+        return AVERROR(err);
+    }
+
+    if (listen(fd, 1) < 0) {
+        int err = errno;
+        close(fd);
+        unlink(idr_control_socket_path);
+        return AVERROR(err);
+    }
+
+    if (pipe(g_wakeup_pipe) < 0) {
+        int err = errno;
+        close(fd);
+        unlink(idr_control_socket_path);
+        return AVERROR(err);
+    }
+
+    g_listen_fd = fd;
+
+    if (pthread_create(&g_listener_thread, NULL, listener_main, NULL) != 0) {
+        close(g_listen_fd);
+        g_listen_fd = -1;
+        close(g_wakeup_pipe[0]);
+        close(g_wakeup_pipe[1]);
+        g_wakeup_pipe[0] = g_wakeup_pipe[1] = -1;
+        unlink(idr_control_socket_path);
+        return AVERROR(errno);
+    }
+    g_thread_started = 1;
+
+    return 0;
+}
+
+void idr_control_stop(void)
+{
+    if (!g_thread_started)
+        return;
+
+    /* Wake the poll() in listener_main() out of its blocking wait -- do not
+     * use pthread_cancel(), which could leave the listening socket or the
+     * wakeup pipe in an inconsistent state if it fires mid-syscall. */
+    if (g_wakeup_pipe[1] >= 0) {
+        char c = 0;
+        ssize_t ignored = write(g_wakeup_pipe[1], &c, 1);
+        (void)ignored;
+    }
+
+    pthread_join(g_listener_thread, NULL);
+    g_thread_started = 0;
+
+    if (g_listen_fd >= 0) {
+        close(g_listen_fd);
+        g_listen_fd = -1;
+    }
+    if (g_wakeup_pipe[0] >= 0) {
+        close(g_wakeup_pipe[0]);
+        close(g_wakeup_pipe[1]);
+        g_wakeup_pipe[0] = g_wakeup_pipe[1] = -1;
+    }
+    if (idr_control_socket_path)
+        unlink(idr_control_socket_path);
+}
+
+#endif /* _WIN32 */
+
+int idr_control_consume_request(int ost_index, int64_t *last_seen_epoch)
+{
+    int64_t epoch = atomic_load(&g_request_epoch);
+
+    if (epoch == 0 || epoch == *last_seen_epoch)
+        return 0;
+
+    {
+        int target = atomic_load(&g_request_target);
+        if (target != -1 && target != ost_index)
+            return 0;
+    }
+
+    *last_seen_epoch = epoch;
+    return 1;
+}
